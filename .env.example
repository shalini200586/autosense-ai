# Copy to .env (never commit .env). Docker Compose reads it automatically.

# --- Database / cache (Compose overrides these hostnames for containers) ---
POSTGRES_PASSWORD=autosense
DATABASE_URL=postgresql+psycopg://autosense:autosense@localhost:5432/autosense
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=30

# --- Web ---
# Comma-separated list of allowed browser origins (CORS + WebSocket origin check)
CORS_ORIGINS=http://localhost:5173,http://localhost:8090
# Optional: if set, PATCH /api/vehicles/{id} requires header X-Admin-Token. Enter it in the Dealer screen.
ADMIN_TOKEN=

# --- AI wording via Groq (optional; free key at https://console.groq.com) ---
# Leave GROQ_API_KEY blank => accurate rule-based answers, labelled "Rule-based fallback". Cards/prices never come from the model.
GROQ_API_KEY=
LLM_ENABLED=true
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model ids change; pick a current one from the Groq console if this stops working.
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=20

# --- Gnani voice (server-side only). Leave blank => "Voice setup required", text chat still works ---
GNANI_API_KEY=
# Defaults below follow docs.gnani.ai; change only if your account/docs differ.
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGES=hi-IN,en-IN
GNANI_STT_FORMAT=verbatim
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE_HI=Nalini
GNANI_TTS_VOICE_EN=Kaveri
